{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhysicalAddress",
  "type": "object",
  "description": "Represents the street address of a resource such as a contact or event.",
  "properties": {
    "street": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "countryOrRegion": {
      "type": "string"
    },
    "postalCode": {
      "type": "string"
    }
  }
}